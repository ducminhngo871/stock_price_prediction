.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
*.egg-info/

# large/raw data: not committed, except the Kaggle CSV (CC0-1.0), which is
# committed so the deployed app is self-contained and needs no Kaggle credentials.
# A directory-level ignore (data/raw/) would block git from ever looking inside it
# to find the negation below, so each level is excluded with a glob instead.
data/raw/*
!data/raw/kaggle_sandp500/
data/raw/kaggle_sandp500/*
!data/raw/kaggle_sandp500/all_stocks_5yr.csv
data/processed/
results/*/
!results/.gitkeep

.DS_Store
